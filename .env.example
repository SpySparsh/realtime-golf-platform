# Public app URL used by redirects, CORS, emails, and Docker health/docs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_TOLERANCE_SECONDS=90000

# Queues, realtime, and optional document store
REDIS_URL=redis://redis:6379
MONGODB_URI=mongodb://mongo:27017/golf_subscription

# Runtime tuning
QUEUE_WORKER_CONCURRENCY=5
WORKER_METRICS_PORT=9101
WEBSOCKET_PORT=3001
WEBSOCKET_CORS_ORIGIN=http://localhost:3000
WEBSOCKET_PING_INTERVAL_MS=25000
WEBSOCKET_PING_TIMEOUT_MS=20000

# Observability
SERVICE_NAME=golf-charity-platform
LOG_LEVEL=info

# Security
# Use a unique high-entropy value in every environment.
CSRF_SECRET=
